<hibernate-mapping>
	<class name = "org.jsp.demo.Employee" table = "emp">
		<id name = "id" column = "eid">
			<!--  <generator class = "identity"/> -->
			<generator class = "assigned"/>
		</id>
		<property name = "name" column = "ename"/>
		<property name = "salary" column = "sal"/>
	</class>

</hibernate-mapping>